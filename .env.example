# Copy to .env. This single file feeds both the app (Next.js / Prisma) and
# docker compose, which reads .env for ${...} interpolation in compose.yml.
#
# The APP section below is filled in for running `pnpm run dev` on the host
# against the compose services. The containerized woolrus service sets its own
# equivalents in compose.yml and ignores most of these.

# ============================================================================
# APP
# ============================================================================

# WordPress / WooCommerce
# WPGraphQL endpoint. The WooCommerce REST base is derived from this by
# stripping the trailing /graphql.
WOO_GRAPHQL_URL="http://localhost:8080/graphql"
# A WordPress user + application password. `docker compose up wp-init` prints
# a ready-made pair; see README.
WP_GRAPHQL_KEY=""
WP_GRAPHQL_SECRET=""

# Database
DATABASE_URL="postgresql://woolrus:woolrus@localhost:5432/woolrus"

# Auth (Discord is the only provider)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# S3-compatible object storage (rustfs)
# lib/s3.ts builds the endpoint as http://S3_END_POINT:S3_PORT
S3_END_POINT="localhost"
S3_PORT="9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="rustfsadmin"
S3_SECRET_KEY="rustfsadmin"
# Bucket holding note attachments. Created by the rustfs-init service.
S3_NOTES_BUCKET="woolrus-notes"

# Bearer token guarding POST /api/sync/pull
SYNC_SECRET=""

# ShipStation
SHIPSTATION_SECRET_KEY=""
SHIP_FROM_NAME="Woolrus"
SHIP_FROM_PHONE="+15555555555"
SHIP_FROM_ADDRESS_LINE1=""
SHIP_FROM_CITY=""
SHIP_FROM_STATE=""
SHIP_FROM_POSTAL_CODE=""
SHIP_FROM_COUNTRY_CODE="US"

# ============================================================================
# DOCKER COMPOSE
# ============================================================================

# Published host ports
WOOLRUS_PORT=3000
WP_PORT=8080
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Databases are only published by compose.override.yml (host-dev mode)
POSTGRES_PORT=5432
MARIADB_PORT=3306

# Woolrus database
POSTGRES_USER=woolrus
POSTGRES_PASSWORD=woolrus
POSTGRES_DB=woolrus

# rustfs credentials. These become S3_ACCESS_KEY / S3_SECRET_KEY for the app.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# WordPress database
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wordpress

# WordPress install, performed once by the wp-init service
WP_URL=http://localhost:8080
WP_TITLE=Woolrus Dev Store
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# WooGraphQL release tag (GitHub, not wordpress.org)
WOOGRAPHQL_VERSION=v1.0.3
